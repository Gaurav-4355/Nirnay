{
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nirnay-iqf3.onrender.com/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon\\.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
