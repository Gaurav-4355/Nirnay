# Groq LLM Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Trello Integration for Outbox tracker cards
# If omitted, Nirnay operates in internal tracker mode
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Optional: Notification Webhook for Discord / Slack reminders
# If omitted, approved webhook items fail with 'No webhook configured'
NOTIFY_WEBHOOK_URL=
